{
  "name": "portfolio-immortalized-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Portfolio Immortalized — Digital legacy custody and controlled-release platform",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "prisma": "^5.21.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3",
    "@typescript-eslint/parser": "^8.11.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
