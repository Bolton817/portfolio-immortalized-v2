# Portfolio Immortalized — Canonical Environment Configuration Template
# Reference: TDD Appendix G (Environment Variables and Secrets Inventory)
# SECURITY RULE: Never commit real secrets to Git. Copy to .env.local for local development.

# ==============================================================================
# Database & ORM (PostgreSQL via Supabase)
# ==============================================================================
# Pooled connection string used by Next.js API and runtime workers
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
# Direct connection string reserved for migrations (prisma migrate)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ==============================================================================
# Authentication & Sessions (Better Auth)
# ==============================================================================
# Cryptographically random high-entropy secret (openssl rand -base64 32)
BETTER_AUTH_SECRET="change-this-to-a-secure-random-32-byte-base64-string"
# Fully qualified base URL for authentication endpoints
BETTER_AUTH_URL="http://localhost:3000"
# Comma-separated list of trusted origins
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:8081"

# ==============================================================================
# Cryptography & Key Management (Envelope Encryption)
# ==============================================================================
# Identifier or ARN for the KMS Master Key Encryption Key (KEK)
KMS_KEY_REFERENCE="local-mock-kek-v1"
# KMS service role / workload identity credentials
KMS_SERVICE_IDENTITY="kms-service-worker-identity"

# ==============================================================================
# Object Storage (Private Vault Storage)
# ==============================================================================
OBJECT_STORAGE_PROVIDER="supabase" # supabase | s3
OBJECT_STORAGE_BUCKET="portfolio-vault-private"
OBJECT_STORAGE_REGION="af-south-1"
OBJECT_STORAGE_CREDENTIALS="{\"endpoint\":\"https://[PROJECT_REF].supabase.co/storage/v1\",\"accessKey\":\"...\",\"secretKey\":\"...\"}"

# ==============================================================================
# Media Delivery & CDN (Optional / Public Media Only)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================================================================
# Notifications & Transactional Email (Brevo / Sendinblue)
# ==============================================================================
BREVO_API_KEY="xkeysib-..."
BREVO_WEBHOOK_SECRET="whsec_..."
BREVO_SENDER_EMAIL="noreply@portfolioimmortalized.com"
BREVO_SENDER_NAME="Portfolio Immortalized Security"

# ==============================================================================
# AI Gateway (Governed Provider-Neutral Service)
# ==============================================================================
GEMINI_API_KEY=""
CLAUDE_API_KEY=""

# ==============================================================================
# Administration & Governance
# ==============================================================================
# Single-use emergency bootstrap token for initial named Super Admin creation
ADMIN_BOOTSTRAP_TOKEN="bootstrap-token-change-in-production"
# Server-controlled feature flags (JSON string)
FEATURE_FLAGS="{\"aiAssistanceEnabled\":true,\"inactivitySweepsEnabled\":false,\"emergencyHoldActive\":false}"

# ==============================================================================
# Client Public Configuration (Safe to expose to browsers/mobile bundles)
# ==============================================================================
PUBLIC_API_BASE_URL="http://localhost:3000/api/v1"
PUBLIC_AUTH_CLIENT_CONFIG="{\"mode\":\"cookie\"}"
